<button
  class="theme-toggle"
  type="button"
  aria-label="Váltás világos témára"
  aria-pressed="false"
>
  <span class="theme-toggle__icon" aria-hidden="true">☀️</span>
  <span class="theme-toggle__label">Világos mód</span>
</button>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const button = document.querySelector(".theme-toggle");
    const icon = button?.querySelector(".theme-toggle__icon");
    const label = button?.querySelector(".theme-toggle__label");
    const storedTheme = localStorage.getItem("theme");
    const initialTheme = storedTheme === "light" ? "light" : "dark";

    function applyTheme(theme) {
      const isLight = theme === "light";
      root.dataset.theme = theme;
      root.style.colorScheme = theme;

      if (button && icon && label) {
        button.setAttribute("aria-pressed", String(isLight));
        button.setAttribute(
          "aria-label",
          isLight ? "Váltás sötét témára" : "Váltás világos témára",
        );
        icon.textContent = isLight ? "🌙" : "☀️";
        label.textContent = isLight ? "Sötét mód" : "Világos mód";
      }
    }

    applyTheme(initialTheme);

    button?.addEventListener("click", () => {
      const nextTheme = root.dataset.theme === "light" ? "dark" : "light";
      localStorage.setItem("theme", nextTheme);
      applyTheme(nextTheme);
    });
  })();
</script>

<style>
  .theme-toggle {
    position: fixed;
    top: 16px;
    right: 16px;
    z-index: 100;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--panel);
    color: var(--text);
    font: inherit;
    font-size: 14px;
    line-height: 1.4;
    cursor: pointer;
    box-shadow: 0 4px 16px var(--shadow);
    transition:
      background-color 0.2s,
      border-color 0.2s,
      color 0.2s,
      transform 0.2s;
  }

  .theme-toggle:hover {
    background: var(--panel-hover);
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  @media (max-width: 600px) {
    .theme-toggle {
      top: 10px;
      right: 10px;
    }

    .theme-toggle__label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }
</style>
