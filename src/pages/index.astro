---
import SearchBox from "../components/SearchBox.tsx";
import ThemeToggle from "../components/ThemeToggle.astro";
import { getCollection } from "astro:content";
const episodes = await getCollection("episodes");
episodes.sort((a, b) => (a.data.date < b.data.date ? 1 : -1));
const quickLinks = [
  { href: "/random", icon: "🎲", label: "Random album" },
  { href: "/bongeszes", icon: "📚", label: "Böngészés stílus/év szerint" },
];
import "../layouts/Layout.astro";
---

<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Metal archívum kereső</title>
  </head>
  <style>
    .search-sticky {
      position: sticky;
      top: 0;
      z-index: 10;
      background: var(--bg);
      padding: 12px 0;
      border-bottom: 1px solid var(--border);
    }

    .quick-links {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .quick-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 40px;
      padding: 7px 14px;
      border: 1px solid color-mix(in srgb, var(--link) 45%, var(--border));
      border-radius: 999px;
      background: color-mix(in srgb, var(--link) 10%, var(--panel));
      color: var(--link);
      font-weight: 600;
      line-height: 1.3;
      text-decoration: none;
      box-shadow: 0 3px 12px var(--shadow);
      transition:
        color 0.2s,
        background-color 0.2s,
        border-color 0.2s,
        box-shadow 0.2s,
        transform 0.2s;
    }

    .quick-link:hover {
      border-color: var(--link);
      background: color-mix(in srgb, var(--link) 17%, var(--panel));
      color: var(--link-hover);
      text-decoration: none;
      box-shadow: 0 5px 18px var(--shadow);
      transform: translateY(-2px);
    }

    .quick-link__icon {
      font-size: 17px;
      line-height: 1;
    }

    .mobile-menu {
      display: none;
    }

    @media (max-width: 640px) {
      .desktop-actions {
        display: none;
      }

      .mobile-menu {
        position: relative;
        display: block;
        width: max-content;
      }

      .mobile-menu summary {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 8px 13px;
        border: 1px solid color-mix(in srgb, var(--link) 45%, var(--border));
        border-radius: 999px;
        background: color-mix(in srgb, var(--link) 10%, var(--panel));
        color: var(--link);
        font-weight: 700;
        line-height: 1.3;
        cursor: pointer;
        list-style: none;
        box-shadow: 0 3px 12px var(--shadow);
      }

      .mobile-menu summary::-webkit-details-marker {
        display: none;
      }

      .mobile-menu summary:focus-visible {
        outline: 2px solid var(--focus);
        outline-offset: 3px;
      }

      .menu-icon {
        font-size: 20px;
        line-height: 1;
        transition: transform 0.2s;
      }

      .mobile-menu[open] .menu-icon {
        transform: rotate(90deg);
      }

      .mobile-menu .quick-links {
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        z-index: 20;
        display: grid;
        width: min(290px, calc(100vw - 32px));
        padding: 10px;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--panel);
        box-shadow: 0 10px 28px var(--shadow);
      }

      .mobile-menu .quick-link {
        width: 100%;
        box-sizing: border-box;
        border-radius: 9px;
        box-shadow: none;
      }
    }
  </style>
  <body>
    <ThemeToggle />
    <main
      style="max-width: 900px; margin: 32px auto; padding: 0 16px; display: grid; gap: 18px;"
    >
      <h1>Magyar metal antológia archívum</h1>

      <nav class="quick-links desktop-actions" aria-label="Gyors elérés">
        {
          quickLinks.map((link) => (
            <a class="quick-link" href={link.href}>
              <span class="quick-link__icon" aria-hidden="true">{link.icon}</span>
              {link.label}
            </a>
          ))
        }
      </nav>

      <details class="mobile-menu">
        <summary>
          <span class="menu-icon" aria-hidden="true">☰</span>
          Menü
        </summary>
        <nav class="quick-links" aria-label="Mobil gyorsmenü">
          {
            quickLinks.map((link) => (
              <a class="quick-link" href={link.href}>
                <span class="quick-link__icon" aria-hidden="true">{link.icon}</span>
                {link.label}
              </a>
            ))
          }
        </nav>
      </details>

      <p style="opacity:.85">
        Keress előadóra / albumra / kulcsszóra. A találat album-szekció szinten
        ugrik.
      </p>

      <div class="search-sticky">
        <SearchBox client:load />
      </div>
      <hr />

      <h2>Epizódok</h2>
      <ul style="display:grid; gap:8px; padding-left: 18px;">
        {
          episodes.map((ep) => (
            <li>
              <a href={`/epizodok/${ep.slug}`}>{ep.data.title}</a>
              <span style="opacity:.75"> — {ep.data.date}</span>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>
